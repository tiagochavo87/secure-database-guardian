PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dblapoge

# OBRIGATÓRIO: gere um valor aleatório próprio, nunca use este exemplo.
# Gerar com: openssl rand -hex 32
JWT_SECRET=

# Lista de origens permitidas separadas por vírgula. Se a aplicação for
# acessada remotamente (VPN, domínio público, túnel), inclua aqui a URL
# real usada pelos usuários (ex.: https://dblapoge.suainstituicao.org),
# além do endereço local se ainda for usado.
CORS_ORIGIN=http://localhost:8080

# URL pública usada para montar o link de reset de senha. Ajuste para o
# domínio/endereço real quando houver acesso remoto (ex.: https://dblapoge.suainstituicao.org/reset-password).
PUBLIC_APP_URL=http://localhost:8080/reset-password

# Envio de email (reset de senha). Se SMTP_HOST ficar vazio, o link só é
# registrado no log do servidor (ok para uso 100% local; insuficiente para
# usuários remotos, que não têm acesso ao log do container).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DBLAPOGE <no-reply@suainstituicao.org>"

INITIAL_ADMIN_EMAIL=admin@local.test
# Defina uma senha forte própria — troque-a assim que fizer o primeiro login.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador Local
