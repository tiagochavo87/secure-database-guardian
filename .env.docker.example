# Copie este arquivo para ".env" (mesma pasta do docker-compose.local.yml)
# e preencha com valores reais antes de subir os containers.
# NUNCA versione o arquivo ".env" resultante.
#
# Gerar valores aleatórios fortes:
#   openssl rand -hex 32   -> use para JWT_SECRET
#   openssl rand -base64 24 -> use para POSTGRES_PASSWORD / INITIAL_ADMIN_PASSWORD

POSTGRES_PASSWORD=
JWT_SECRET=
INITIAL_ADMIN_EMAIL=admin@local.test
INITIAL_ADMIN_PASSWORD=

# Ajuste para o(s) endereço(s) real(is) usados pelos usuários. Separe por
# vírgula se houver mais de um (ex.: acesso local + acesso remoto via VPN/domínio).
# Ao usar o docker-compose.remote.yml (Caddy), normalmente basta https://$DOMAIN.
CORS_ORIGIN=http://localhost:8080

# URL pública usada para montar o link de reset de senha.
PUBLIC_APP_URL=http://localhost:8080/reset-password
INITIAL_ADMIN_NAME=Administrador Local

# --- Acesso remoto (docker-compose.remote.yml) ---

# Domínio público real com DNS apontando para este servidor (portas 80/443
# liberadas) para o Caddy emitir HTTPS automaticamente via Let's Encrypt.
# Deixe "localhost" para testar localmente com certificado interno (o
# navegador vai avisar que o emissor não é confiável — normal em teste local).
DOMAIN=localhost

# Envio real de email para reset de senha. Sem isso, o link só aparece no
# log do container da API — inviável para usuários remotos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DBLAPOGE <no-reply@suainstituicao.org>"
